{
    "name": "adv-backend-template",
    "version": "1.0.0",
    "description": "Generic Node.js/Express Backend Template",
    "main": "server.js",
    "scripts": {
        "format:check": "prettier --check .",
        "format": "prettier --write .",
        "lint:check": "eslint .",
        "lint": "eslint --fix .",
        "test": "echo \"Error: no test specified\" && exit 0",
        "prestart": "npx sequelize-cli db:migrate",
        "db:seed": "npx sequelize-cli db:seed:all",
        "db:reset": "npx sequelize-cli db:migrate:undo:all && npx sequelize-cli db:migrate",
        "db:create:script": "node src/utils/dbCreate.util.js",
        "db:create:service": "node src/scripts/createServiceDatabase.js",
        "create-admin": "node src/scripts/createAdmin.js",
        "start": "node server.js",
        "dev": "nodemon server.js",
        "prod:start": "pm2 start ecosystem.config.js --env production",
        "prod:restart": "pm2 restart ecosystem.config.js",
        "legacy:pm2:start": "pm2 start npm --name adv-backend -- run start",
        "legacy:pm2:restart": "pm2 restart adv-backend"
    },
    "author": "",
    "license": "ISC",
    "dependencies": {
        "bcrypt": "^6.0.0",
        "compression": "^1.8.0",
        "cors": "^2.8.5",
        "dotenv": "^16.6.1",
        "express": "^5.1.0",
        "helmet": "^8.1.0",
        "joi": "^17.13.3",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.0",
        "multer": "^2.0.0",
        "nodemailer": "^7.0.12",
        "pg": "^8.16.0",
        "pgsn": "^1.1.3",
        "pino": "^9.7.0",
        "pino-pretty": "^13.0.0",
        "sequelize": "^6.37.7",
        "socket.io": "^4.7.2",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "uuid": "^11.1.0"
    },
    "devDependencies": {
        "axios": "^1.13.4",
        "cross-env": "^7.0.3",
        "dotenv-cli": "^10.0.0",
        "eslint": "^9.27.0",
        "eslint-config-prettier": "^10.1.5",
        "nodemon": "^3.1.10",
        "prettier": "^3.5.3",
        "sequelize-cli": "^6.6.3"
    }
}
