meta {
  name: Initiate Call From Chat
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/calls/session
  body: json
  data: {
    "clientId": "{{callerId}}",
    "chatSessionId": "{{chatSessionId}}"
  }
  auth: none
}

auth:none {}

docs {
  # Initiate Call From Chat

  Starts a new call session using an existing chat session context.

  ## Body

  - `clientId` (required)
  - `chatSessionId` (optional)
} 
