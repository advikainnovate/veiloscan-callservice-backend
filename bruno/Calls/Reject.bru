headers {
  x-api-key: {{apiKey}}
}

docs {
  # Reject Call (HTTP)

  Updates the session status to `ended` in the database.
  This is the HTTP counterpart — for real-time rejection use the socket SDK:
  `sdk.rejectCall(sessionId)`
}
