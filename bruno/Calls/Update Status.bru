meta {
  name: Update Call Status
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/api/v1/calls/{{callId}}/status
  body: json
  data: {
    "status": "{{status}}",
    "endedReason": "{{endedReason}}"
  }
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  # Update Call Status

  Transitions a call to ringing, connected, ended, or failed.
}
