meta {
  name: Accept Call (HTTP)
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/v1/calls/session/{{sessionId}}/accept
  body: none
  auth: none
}

headers {
  x-api-key: {{apiKey}}
}

docs {
  # Accept Call (HTTP)

  Updates the session status to `connecting` in the database.
  This is the HTTP counterpart — for real-time ringing use the socket SDK:
  `sdk.acceptCall(sessionId)`
}
