meta {
  name: End Call (HTTP)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/calls/session/{{sessionId}}/end
  body: none
  auth: none
}

headers {
  x-api-key: {{apiKey}}
}

docs {
  # End Call (HTTP)

  Marks the session as `ended` and records duration.
  This is the HTTP counterpart — for real-time call ending use the socket SDK:
  `sdk.endCall()`

  The socket `end-call` event handles notifying all participants in real time.
}
