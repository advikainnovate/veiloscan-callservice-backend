meta {
  name: Get Call History
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/calls/session
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
      "clientId": "{{clientId}}"
    }
}

vars:pre-request {
  clientId: 1
}

docs {
  # Call History
  
  Returns the authenticated user's recent call history.
}
