meta {
  name: Get Call Session
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/calls/session/{{sessionId}}
  body: none
  auth: none
}

headers {
  x-api-key: {{apiKey}}
}

docs {
  # Get Call Session

  Returns details for a call session including status, duration, callerUserId, calleeUserId.

  ## Status values
  idle → ringing → connecting → connected → ended / failed
}
