meta {
  name: Create QR Code
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/qr-codes/create
  body: json
  data: {
    "title": "{{title}}",
    "description": "{{description}}"
  }
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  # Create QR Code

  Creates a new QR code entry. Requires admin auth.
}
