meta {
  name: Get My QR Codes
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/qr-codes/batch/create
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
      "count": {{count}},
      "prefix": {{prefix}}
    }
}

docs {
  # Get My QR Codes
  
  Lists QR codes assigned to the current admin user.
}
