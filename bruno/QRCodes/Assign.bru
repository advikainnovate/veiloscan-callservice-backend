meta {
  name: Assign QR Code
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/qr-codes/{{qrCodeId}}/assign
  body: json
  data: {
    "userId": "{{userId}}"
  }
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  # Assign QR Code

  Assigns a QR code to a user. Requires admin auth.
}
