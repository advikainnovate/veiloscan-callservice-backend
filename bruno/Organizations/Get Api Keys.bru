meta {
  name: Get Api Keys
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/organizations/me/api-keys
  auth: none
}

headers {
  x-api-key: {{apiKey}}
}

docs {
  # Get API Keys

  Returns the list of API keys for the authenticated organization.
  apiKeyHash is excluded from the response.
  Requires x-api-key header.
}
