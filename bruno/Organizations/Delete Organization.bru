meta {
  name: Delete Organization
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/api/v1/organizations/me
  auth: none
}

headers {
  x-api-key: {{apiKey}}
}

docs {
  # Delete Organization

  Deletes the authenticated organization.
  Identity is derived from the x-api-key header — no org ID needed in the URL.
}
