meta {
  name: Revoke Api Key
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/api/v1/organizations/me/api-keys/{{apiKeyId}}/revoke
  auth: none
}

headers {
  x-api-key: {{apiKey}}
}

vars:pre-request {
  apiKeyId: 
}

docs {
  # Revoke API Key

  Revokes an API key belonging to the authenticated organization.
  The key must belong to the org identified by x-api-key — prevents revoking other orgs' keys.
}
