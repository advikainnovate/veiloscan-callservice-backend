meta {
  name: Initiate Chat Session
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/chat-sessions/initiate
  body: json
  data: {
    "participant1Id": "{{participant1Id}}",
    "participant2Id": "{{participant2Id}}",
    "qrId": "{{qrId}}"
  }
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  # Initiate Chat Session

  Creates a new chat session between two users.
}
