meta {
  name: Create Chat Room
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/chat-sessions/rooms
  body: json
  auth: none
}

headers {
  x-api-key: {{apiKey}}
}

body:json {
  {
    "roomName": "Support Chat",
    "organizationId": "{{orgId}}"
  }
}

docs {
  # Create Chat Room

  Creates a new chat room. Returns the room ID to use in socket events.
  Requires x-api-key header.

  ## After this call
  Use the returned `id` as `roomId` in:
  - SDK: `chat.joinRoom(roomId)`
  - GET messages: `/chat-sessions/rooms/:roomId/messages`
}
