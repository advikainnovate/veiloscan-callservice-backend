meta {
  name: Create Chat Room
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/chat-sessions/rooms
  body: json
  auth: none
}

headers {
  x-api-key: {{apiKey}}
}

body:json {
  {
    "roomName": "Support Room",
    "organizationId": "{{orgId}}"
  }
}

docs {
  # Create Chat Room

  Creates a new chat room.
  Requires x-api-key header to identify the organization.
}
