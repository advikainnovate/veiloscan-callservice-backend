meta {
  name: Register
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/users/register
  body: {
    "username": "john.doe",
    "email": "john.doe@example.com",
    "password": "Secret123",
    "countryCode": "+1",
    "phone": "1234567890",
    "gender": "male",
    "emergencyContact": "+11234567890"
  }
  auth: none
}

docs {
  # Register

  Register a new user account. This endpoint creates a normal user with role `user`.

  ## Body
  - `username` (required)
  - `email` (required)
  - `password` (required)
  - `phone` (optional)
  - `countryCode` (optional)
  - `gender` (optional)
  - `emergencyContact` (optional)

  ## Example Response
  ```json
  {
    "success": true,
    "code": 201,
    "message": "Successfully created",
    "data": {
      "id": "uuid",
      "idd": "NXSU01000000001",
      "role": "user",
      "username": "john.doe",
      "display_name": "john.doe",
      "email": "john.doe@example.com",
      "countryCode": "+1",
      "phone": "1234567890",
      "emergencyContact": "+11234567890",
      "gender": "male",
      "status": "active",
      "accessToken": "...",
      "refreshToken": "..."
    }
  }
  ```
}
