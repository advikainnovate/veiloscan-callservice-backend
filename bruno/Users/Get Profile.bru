meta {
  name: Get Profile
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/users/profile
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  # Get Profile
  
  Get the authenticated user's profile.
  
  ## Authentication
  
  Requires Bearer token in Authorization header.
  
  ## Example Response
  ```json
  {
    "success": true,
    "code": 201,
    "message": "Success",
    "data": {
      "id": "uuid",
      "idd": "NXCS01000000001",
      "userType": "client",
      "username": "john.doe@example.com",
      "display_name": "johndoe",
      "firstName": "John",
      "lastName": "Doe",
      "email": "john.doe@example.com",
      "countryCode": "+1",
      "phoneNumber": "1234567890",
      "gender": "male",
      "status": "active",
      "createdAt": "2026-01-28T12:00:00.000Z",
      "updatedAt": "2026-01-28T12:00:00.000Z",
      "deletedAt": null
    }
  }
  ```
  
  ## Notes
  - Requires admin role
  - Password is not included in response
}
