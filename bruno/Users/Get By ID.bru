meta {
  name: Get By ID
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/users/{{userId}}/view
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  # Get User by ID
  
  Get a specific user by their ID.
  
  ## Authentication
  
  Requires Bearer token with admin role.
  
  ## Path Parameters
  
  | Parameter | Type | Required | Description |
  |-----------|------|----------|-------------|
  | `userId` | string | **Required** | User UUID |
  
  ## Example Response
  ```json
  {
    "success": true,
    "code": 201,
    "message": "Success",
    "data": {
      "id": "uuid",
      "idd": "NXCS01000000001",
      "userType": "client",
      "username": "john.doe@example.com",
      "display_name": "johndoe",
      "firstName": "John",
      "lastName": "Doe",
      "email": "john.doe@example.com",
      "countryCode": "+1",
      "phoneNumber": "1234567890",
      "gender": "male",
      "status": "active",
      "createdAt": "2026-01-28T12:00:00.000Z",
      "updatedAt": "2026-01-28T12:00:00.000Z",
      "deletedAt": null
    }
  }
  ```
}
