meta {
  name: Login
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/api/v1/users/login
  body: {
    "email": "admin@example.com",
    "password": "Secret123"
  }
  auth: none
}

docs {
  # Login

  Log in with email and password to receive access and refresh tokens.

  ## Body
  - `email` (required)
  - `password` (required)

  ## Example Response
  ```json
  {
    "success": true,
    "code": 200,
    "message": "Successfully LoggedIn",
    "data": {
      "id": "uuid",
      "idd": "NXSU01000000001",
      "role": "super_admin",
      "username": "Sudo",
      "display_name": "Sudo",
      "email": "admin@example.com",
      "countryCode": null,
      "phone": null,
      "emergencyContact": null,
      "gender": "male",
      "status": "active",
      "accessToken": "...",
      "refreshToken": "..."
    }
  }
  ```
}
